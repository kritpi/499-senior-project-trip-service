sequenceDiagram
    autonumber
    actor Client
    participant Fiber as Fiber Router
    participant Auth as AuthMiddleware
    participant Handler as RestHandler
    participant Service
    participant Repo
    participant DB

    Client->>Fiber: DELETE /api/v1/trip/:id/expense (Authorization, body)
    Fiber->>Auth: Authenticate
    alt auth failed
        Auth-->>Client: 401 {message}
    else auth ok
        Auth-->>Fiber: set Locals("user")
        Fiber->>Handler: DeleteTripExpense
        alt invalid trip id or body
            Handler-->>Client: 400 {message}
        else valid input
            Handler->>Service: DeleteExpense(trip_id, expense_id, member_id)
            Service->>Repo: GetTripMemberRole
            Repo->>DB: SELECT role
            DB-->>Repo: role
            alt insufficient role
                Service-->>Handler: error
                Handler-->>Client: 500 {message}
            else allowed
                Service->>Repo: Transactional
                Repo->>DB: DELETE expense_member by expense_id
                Repo->>DB: DELETE expense
                Service-->>Handler: ok
                Handler-->>Client: 201 {message: "deleted"}
            end
        end
    end
