sequenceDiagram
    autonumber
    actor Client
    participant Fiber as Fiber Router
    participant Auth as AuthMiddleware
    participant Handler as RestHandler
    participant Service
    participant Repo
    participant DB

    Client->>Fiber: DELETE /api/v1/trip/invitation (Authorization, body)
    Fiber->>Auth: Authenticate
    alt auth failed
        Auth-->>Client: 401 {message}
    else auth ok
        Auth-->>Fiber: set Locals("user")
        Fiber->>Handler: DeleteInvitedMember
        alt invalid body
            Handler-->>Client: 400 {message}
        else valid body
            Handler->>Service: DeleteInvitedMember(trip_id, email)
            Service->>Repo: CheckExistingMember(email)
            Repo->>DB: SELECT member by email
            DB-->>Repo: member
            Service->>Repo: DeleteInvitedMember(member_id, trip_id)
            Repo->>DB: DELETE trip_member
            DB-->>Repo: ok
            Service-->>Handler: ok
            Handler-->>Client: 201 {message: "deleted"}
        end
    end
