sequenceDiagram
    autonumber
    actor Client
    participant Fiber as Fiber Router
    participant Auth as AuthMiddleware
    participant Handler as RestHandler
    participant Service
    participant Repo
    participant DB

    Client->>Fiber: GET /api/v1/trip/:id/expense (Authorization)
    Fiber->>Auth: Authenticate
    alt auth failed
        Auth-->>Client: 401 {message}
    else auth ok
        Auth-->>Fiber: set Locals("user")
        Fiber->>Handler: GetTripExpense
        alt invalid trip id
            Handler-->>Client: 400 {message}
        else valid trip id
            Handler->>Service: TripExpenseGet(trip_id, member_id)
            Service->>Repo: GetTripById
            Repo->>DB: SELECT trip
            DB-->>Repo: trip
            Service->>Repo: GetTripExpenseTotalAmount
            Repo->>DB: SELECT SUM expenses
            DB-->>Repo: total_amount
            Service->>Repo: GetTripMemberTotalExpenses
            Repo->>DB: SELECT member total
            DB-->>Repo: member_total
            Service->>Repo: GetTripExpenses
            Repo->>DB: SELECT expenses + splits
            DB-->>Repo: expenses
            Service-->>Handler: trip expense response
            Handler-->>Client: 200 trip expense response
        end
    end
